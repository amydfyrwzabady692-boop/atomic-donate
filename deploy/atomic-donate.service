[Unit]
Description=Atomic Donate
After=network.target

[Service]
User=www-data
Group=www-data
WorkingDirectory=/opt/atomic-donate
EnvironmentFile=/opt/atomic-donate/.env
ExecStart=/opt/atomic-donate/venv/bin/daphne -b 127.0.0.1 -p 8000 config.asgi:application
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
